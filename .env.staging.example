# ============================================================
# RUBRICA - STAGING ENVIRONMENT
# ============================================================
# Copy this file to .env.staging and initialize isolated secrets with:
#   make staging-secrets-init
#
# Staging runs the complete application topology in Docker, uses only
# fake/local providers by default and never shares production credentials.
# Keep passwords, API keys, signing keys and tokens out of this file.
# Store them as individual files inside SECRETS_DIR.

# ------------------------------------------------------------
# DEPLOYMENT
# ------------------------------------------------------------
ENVIRONMENT=staging
RUNTIME_ENVIRONMENT=staging
# Relative to the compose/ directory, where Compose resolves secret files.
SECRETS_DIR=../.secrets/staging
RUBRICA_DOMAIN=staging.rubrica.local
# Relative to compose/staging.yml. Backend and frontend are sibling checkouts.
RUBRICA_WEB_CONTEXT=../../../rubrica-front
STAGING_GATEWAY_HOST_PORT=7271
PUBLIC_WEB_URL=http://127.0.0.1:7271
SIGNING_APP_URL=http://127.0.0.1:7271/signing

# ------------------------------------------------------------
# POSTGRESQL DATABASES
# ------------------------------------------------------------
POSTGRES_USER=rubrica
POSTGRES_DB=rubrica
CORE_POSTGRES_DB=rubrica_core
AUTH_POSTGRES_DB=rubrica_auth
EVENTING_POSTGRES_DB=rubrica_eventing
NOTIFICATION_POSTGRES_DB=rubrica_notification
OBSERVABILITY_POSTGRES_DB=rubrica_observability

# ------------------------------------------------------------
# DOCUMENT STORAGE AND UPLOAD LIMITS
# ------------------------------------------------------------
# Staging persists files in the named Docker volume document_storage.
# It must never use the production R2 bucket.
DOCUMENT_STORAGE_PROVIDER=local
R2_DOCUMENTS_PREFIX=
DOCUMENT_MAX_SIZE_BYTES=52428800
DOCUMENT_MAX_PAGES=1000

# ------------------------------------------------------------
# BILLING
# ------------------------------------------------------------
# Fake by default. Switch to stripe only while testing the Stripe sandbox.
BILLING_PROVIDER=fake
BILLING_GRACE_PERIOD_DAYS=10

# Optional Stripe test-mode Price IDs. They may remain empty until that
# integration is under test.
STRIPE_PRICE_ESSENTIAL_MONTHLY_BRL=
STRIPE_PRICE_ESSENTIAL_ANNUAL_BRL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY_BRL=
STRIPE_PRICE_PROFESSIONAL_ANNUAL_BRL=
STRIPE_PRICE_TEAM_MONTHLY_BRL=
STRIPE_PRICE_TEAM_ANNUAL_BRL=
STRIPE_PORTAL_CONFIGURATION_ID=

# ------------------------------------------------------------
# AUTHENTICATION, MFA AND SERPRO
# ------------------------------------------------------------
AUTH_SEED_ADMIN_EMAIL=admin@staging.rubrica.local
# Shared test-fixture password published only by the staging MkDocs page at
# /test-accounts/. Never reuse this value in production or for real accounts.
LOCAL_TEST_ACCOUNT_PASSWORD=RubricaLocal123!
AUTH_MFA_ISSUER=Rubrica Staging
AUTH_MFA_CHALLENGE_TTL_SECONDS=300
SERPROID_CLIENT_ID=
SERPROID_ENVIRONMENT=homologation
SERPRO_TIMESTAMP_PROVIDER=fake
SERPRO_TIMESTAMP_CONSUMER_KEY=
SERPRO_TIMESTAMP_ACCEPTED_POLICY_OIDS=

# ------------------------------------------------------------
# INTERNAL API AUTHENTICATION
# ------------------------------------------------------------
# Service keys are staging-only files created inside SECRETS_DIR.
NOTIFICATION_INTERNAL_ALLOWED_SERVICES_RAW=auth_api,core_api,bootstrap

# ------------------------------------------------------------
# SERVICE CAPACITY
# ------------------------------------------------------------
CORE_WEB_CONCURRENCY=1
AUTH_WEB_CONCURRENCY=1
OBSERVABILITY_WEB_CONCURRENCY=1

# ------------------------------------------------------------
# EMAIL AND CONTACT
# ------------------------------------------------------------
# local_ack records the operation without sending real email.
NOTIFICATION_EMAIL_PROVIDER=local_ack
NOTIFICATION_DEFAULT_FROM_EMAIL=no-reply@staging.rubrica.local
RESEND_FROM_EMAIL=Rubrica Staging <no-reply@staging.rubrica.local>
CONTACT_INBOX_EMAIL=contact@staging.rubrica.local

# ------------------------------------------------------------
# CLOUDFLARE TURNSTILE
# ------------------------------------------------------------
# Disabled by default in isolated staging. Its placeholder remains a Docker
# Secret so the container contract stays equivalent to production.
CONTACT_TURNSTILE_SITE_KEY=

# ------------------------------------------------------------
# OBSERVABILITY API
# ------------------------------------------------------------
# Platform Infra may be unavailable; telemetry must degrade without blocking
# authentication, documents or signatures.
PLATFORM_GRAFANA_URL=http://grafana:3000
PLATFORM_GRAFANA_TIMEOUT_SECONDS=3
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://tempo:4318/v1/traces

# ------------------------------------------------------------
# STAGING DOCKER SECRETS
# ------------------------------------------------------------
# `make staging-secrets-init` creates non-production placeholders with mode
# 0600 and never overwrites existing files. Required names include:
#   postgres_password
#   auth_seed_admin_password
#   auth_mfa_encryption_key
#   auth_identity_encryption_key
#   auth_identity_hmac_key
#   core_internal_service_key
#   notification_internal_service_key
#   evidence_secret
#   tenant_identity_encryption_key
#   tenant_identity_hmac_key
#   stripe_secret_key
#   stripe_webhook_secret
#   resend_api_key
#   contact_turnstile_secret_key
#   serproid_client_secret
#   platform_grafana_service_token
#   observability_internal_service_key
