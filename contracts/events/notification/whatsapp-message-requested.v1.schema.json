{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Notification WhatsApp Message Requested",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "source",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "const": "notification.whatsapp_message_requested"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "notification_api"
    },
    "version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "to",
        "body"
      ],
      "properties": {
        "to": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
