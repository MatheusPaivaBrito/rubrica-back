{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Core Item Created",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "source",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "const": "core.item_created"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "core_api"
    },
    "version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "item_id",
        "name"
      ],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
