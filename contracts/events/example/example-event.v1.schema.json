{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Example Event",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "source",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "const": "example.event"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "payload": {
      "type": "object"
    }
  }
}
