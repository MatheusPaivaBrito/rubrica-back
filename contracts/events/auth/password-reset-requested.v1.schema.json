{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auth Password Reset Requested",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "source",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "const": "auth.password_reset_requested"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "auth_api"
    },
    "version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "user_id",
        "email"
      ],
      "properties": {
        "user_id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
