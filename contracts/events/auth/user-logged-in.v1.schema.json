{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auth User Logged In",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "source",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "auth.user_logged_in"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "auth_api"
    },
    "version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "user_id",
        "email"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "email": {
          "type": "string"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
