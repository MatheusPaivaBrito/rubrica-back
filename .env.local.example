# ------------------------------------
# GLOBAL
# ------------------------------------
APP_NAME=Rubrica
ENVIRONMENT=local
APP_DEBUG=true

# ------------------------------------
# LOCAL API PORTS
# ------------------------------------
CORE_API_PORT=8100
CORE_WEB_CONCURRENCY=2
AUTH_API_PORT=8101
AUTH_API_URL=http://localhost:8101
DOCUMENT_STORAGE_PATH=.rubrica-storage
SIGNING_APP_URL=http://localhost:8080/signing
RUBRICA_WEB_PORT=8080
AUTH_SEED_ADMIN_EMAIL=admin@example.local
# Use a unique local password before running `make seed-auth`.
AUTH_SEED_ADMIN_PASSWORD=change-me-before-seeding
AUTH_WEB_CONCURRENCY=2
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_HOST_PORT=6381

# ------------------------------------
# LOCAL INFRA
# ------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_HOST_PORT=5435
POSTGRES_USER=rubrica
POSTGRES_PASSWORD=rubrica
POSTGRES_DB=postgres
CORE_POSTGRES_DB=rubrica_core
AUTH_POSTGRES_DB=rubrica_auth
CORE_REDIS_ENABLED=false
