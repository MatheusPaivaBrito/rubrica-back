# Copy only the variable names you need into a root-owned environment file.
# Never commit the real PKCS#12 file, passwords, API secrets or trust bundles.

ECNPJ_PFX_FILE=/etc/rubrica/secrets/empresa-ecnpj-a1.pfx
ECNPJ_PFX_PASSWORD_FILE=/etc/rubrica/secrets/empresa-ecnpj-a1.password
ECNPJ_ICP_TRUST_ROOTS_FILE=/etc/rubrica/secrets/icp-brasil-trust-roots.pem

# Download the currently applicable PAdES policy directly from the ITI repository
# and confirm that it is still in force before signing.
ECNPJ_SIGNATURE_POLICY_FILE=/etc/rubrica/policies/PA_PAdES_AD_RB_v1_3.der
ECNPJ_SIGNATURE_POLICY_URL=http://politicas.icpbrasil.gov.br/PA_PAdES_AD_RB_v1_3.der

SERPRO_TIMESTAMP_PROVIDER=serpro
SERPRO_TIMESTAMP_CONSUMER_KEY=replace-with-consumer-key
SERPRO_TIMESTAMP_CONSUMER_SECRET_FILE=/etc/rubrica/secrets/serpro_timestamp_consumer_secret
SERPRO_TIMESTAMP_TRUST_ROOTS_FILE=/etc/rubrica/secrets/serpro_timestamp_trust_roots.pem
SERPRO_TIMESTAMP_ACCEPTED_POLICY_OIDS=replace-with-approved-timestamp-policy-oid
