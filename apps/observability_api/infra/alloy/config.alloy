logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "project" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "project_logs" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "project" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.project.targets
  labels        = { platform = "docker" }
  relabel_rules = discovery.relabel.project_logs.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
