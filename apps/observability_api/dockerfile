FROM python:3.14-slim

WORKDIR /app
COPY pyproject.toml poetry.lock README.md ./
RUN pip install --no-cache-dir poetry \
    && poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-root
COPY . .
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=apps/observability_api/src:packages/shared_kernel/src
CMD ["sh", "-c", "exec gunicorn observability_api.main:app -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000 --workers ${OBSERVABILITY_WEB_CONCURRENCY:-1}"]
