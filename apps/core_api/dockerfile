FROM python:3.14-slim

WORKDIR /app
COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir poetry \
    && poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-root
COPY . .
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=apps/core_api/src:packages/shared_kernel/src
CMD ["sh", "-c", "exec gunicorn core_api.main:app -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000 --workers ${CORE_WEB_CONCURRENCY:-2}"]
