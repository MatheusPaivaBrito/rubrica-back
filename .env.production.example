# ============================================================
# RUBRICA - PRODUCTION ENVIRONMENT
# ============================================================
# Copy this file to .env.production and edit it with:
#   nano .env.production
#
# Keep passwords, API keys, signing keys and tokens out of this file.
# Store them as individual files inside SECRETS_DIR.

# ------------------------------------------------------------
# DEPLOYMENT
# ------------------------------------------------------------
ENVIRONMENT=production
RUBRICA_DOMAIN=rubricasignature.com
SECRETS_DIR=/etc/rubrica/secrets
# Relative to compose/production.yml. Production checkouts are siblings named
# rubrica-back and rubrica-front under the same parent directory.
RUBRICA_WEB_CONTEXT=../../../rubrica-front
GATEWAY_HOST_PORT=7171

# ------------------------------------------------------------
# POSTGRESQL DATABASES
# ------------------------------------------------------------
POSTGRES_USER=rubrica
POSTGRES_DB=rubrica
CORE_POSTGRES_DB=rubrica_core
AUTH_POSTGRES_DB=rubrica_auth
EVENTING_POSTGRES_DB=rubrica_eventing
NOTIFICATION_POSTGRES_DB=rubrica_notification

# Keep local during the one-time migration. Change to r2 only after every
# existing object has been copied and its SHA-256 verified.
DOCUMENT_STORAGE_PROVIDER=local
R2_DOCUMENTS_PREFIX=documents
# Required files in SECRETS_DIR when enabled: r2_documents_endpoint,
# r2_documents_access_key_id, r2_documents_secret_access_key,
# r2_documents_bucket.

# ------------------------------------------------------------
# STRIPE BILLING
# ------------------------------------------------------------
# Secret files required in SECRETS_DIR:
#   stripe_secret_key
#   stripe_webhook_secret

# --- Essential: 20 documents per month ---
STRIPE_PRICE_ESSENTIAL_MONTHLY_BRL=price_replace_me
STRIPE_PRICE_ESSENTIAL_MONTHLY_USD=
STRIPE_PRICE_ESSENTIAL_MONTHLY_EUR=
STRIPE_PRICE_ESSENTIAL_MONTHLY_JPY=
STRIPE_PRICE_ESSENTIAL_ANNUAL_BRL=price_replace_me
STRIPE_PRICE_ESSENTIAL_ANNUAL_USD=
STRIPE_PRICE_ESSENTIAL_ANNUAL_EUR=
STRIPE_PRICE_ESSENTIAL_ANNUAL_JPY=

# --- Professional: 80 documents per month; up to 3 tenant accounts ---
STRIPE_PRICE_PROFESSIONAL_MONTHLY_BRL=price_replace_me
STRIPE_PRICE_PROFESSIONAL_MONTHLY_USD=
STRIPE_PRICE_PROFESSIONAL_MONTHLY_EUR=
STRIPE_PRICE_PROFESSIONAL_MONTHLY_JPY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL_BRL=price_replace_me
STRIPE_PRICE_PROFESSIONAL_ANNUAL_USD=
STRIPE_PRICE_PROFESSIONAL_ANNUAL_EUR=
STRIPE_PRICE_PROFESSIONAL_ANNUAL_JPY=

# --- Team: 200 documents per month; up to 10 tenant accounts ---
STRIPE_PRICE_TEAM_MONTHLY_BRL=price_replace_me
STRIPE_PRICE_TEAM_MONTHLY_USD=
STRIPE_PRICE_TEAM_MONTHLY_EUR=
STRIPE_PRICE_TEAM_MONTHLY_JPY=
STRIPE_PRICE_TEAM_ANNUAL_BRL=price_replace_me
STRIPE_PRICE_TEAM_ANNUAL_USD=
STRIPE_PRICE_TEAM_ANNUAL_EUR=
STRIPE_PRICE_TEAM_ANNUAL_JPY=
STRIPE_PORTAL_CONFIGURATION_ID=

# Days allowed after a failed subscription payment.
BILLING_GRACE_PERIOD_DAYS=10

# ------------------------------------------------------------
# AUTHENTICATION AND MFA
# ------------------------------------------------------------
# Sensitive Auth and tenant identity values are stored as files in SECRETS_DIR.
# Required tenant identity secret files:
#   tenant_identity_encryption_key
#   tenant_identity_hmac_key
AUTH_SEED_ADMIN_EMAIL=admin@rubricasignature.com
SERPROID_CLIENT_ID=
SERPROID_ENVIRONMENT=production
# Store the client secret only in SECRETS_DIR/serproid_client_secret.
# Leave both Timestamp values empty until the service is enabled with
# compose/features/serpro-timestamp.yml.
SERPRO_TIMESTAMP_PROVIDER=fake
SERPRO_TIMESTAMP_CONSUMER_KEY=
AUTH_MFA_ISSUER=Rubrica
AUTH_MFA_CHALLENGE_TTL_SECONDS=300

# ------------------------------------------------------------
# INTERNAL API AUTHENTICATION
# ------------------------------------------------------------
# X-Rubrica-Service-Key values live in core_internal_service_key and
# notification_internal_service_key inside SECRETS_DIR.
NOTIFICATION_INTERNAL_ALLOWED_SERVICES_RAW=auth_api,core_api,bootstrap

# ------------------------------------------------------------
# SERVICE CAPACITY
# ------------------------------------------------------------
CORE_WEB_CONCURRENCY=2
AUTH_WEB_CONCURRENCY=2

# ------------------------------------------------------------
# EMAIL AND CONTACT
# ------------------------------------------------------------
# Secret file required in SECRETS_DIR:
#   resend_api_key
NOTIFICATION_DEFAULT_FROM_EMAIL=no-reply@rubricasignature.com
RESEND_FROM_EMAIL=Rubrica <no-reply@rubricasignature.com>
CONTACT_INBOX_EMAIL=contact@rubricasignature.com

# ------------------------------------------------------------
# DOCUMENT UPLOAD LIMITS
# ------------------------------------------------------------
# 50 MiB in bytes.
DOCUMENT_MAX_SIZE_BYTES=52428800
DOCUMENT_MAX_PAGES=1000

# ------------------------------------------------------------
# CLOUDFLARE TURNSTILE
# ------------------------------------------------------------
# Site key from a Turnstile widget for rubricasignature.com. Store the secret
# only in SECRETS_DIR/contact_turnstile_secret_key.
CONTACT_TURNSTILE_SITE_KEY=
