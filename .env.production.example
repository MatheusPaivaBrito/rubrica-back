# ============================================================
# RUBRICA - PRODUCTION ENVIRONMENT
# ============================================================
# Copy this file to .env.production and edit it with:
#   nano .env.production
#
# Keep passwords, API keys, signing keys and tokens out of this file.
# Store them as individual files inside SECRETS_DIR.

# ------------------------------------------------------------
# DEPLOYMENT
# ------------------------------------------------------------
RUBRICA_DOMAIN=rubricasignature.com
SECRETS_DIR=/etc/rubrica/secrets
# Relative path from this backend repository to rubrica-web.
RUBRICA_WEB_CONTEXT=../../rubrica-web

# ------------------------------------------------------------
# POSTGRESQL DATABASES
# ------------------------------------------------------------
POSTGRES_USER=rubrica
POSTGRES_DB=rubrica
CORE_POSTGRES_DB=rubrica_core
AUTH_POSTGRES_DB=rubrica_auth
EVENTING_POSTGRES_DB=rubrica_eventing
NOTIFICATION_POSTGRES_DB=rubrica_notification

# ------------------------------------------------------------
# STRIPE BILLING
# ------------------------------------------------------------
# Secret files required in SECRETS_DIR:
#   stripe_secret_key
#   stripe_webhook_secret

# --- Base plan ---
STRIPE_PRICE_BRL=price_replace_me
STRIPE_PRICE_USD=
STRIPE_PRICE_EUR=
STRIPE_PRICE_JPY=

# --- Intermediate plan ---
STRIPE_PRICE_INTERMEDIATE_BRL=price_replace_me
STRIPE_PRICE_INTERMEDIATE_USD=
STRIPE_PRICE_INTERMEDIATE_EUR=
STRIPE_PRICE_INTERMEDIATE_JPY=

# Days allowed after a failed subscription payment.
BILLING_GRACE_PERIOD_DAYS=10

# ------------------------------------------------------------
# AUTHENTICATION AND MFA
# ------------------------------------------------------------
# Sensitive Auth values are stored as files in SECRETS_DIR.
AUTH_SEED_ADMIN_EMAIL=admin@rubricasignature.com
AUTH_MFA_ISSUER=Rubrica
AUTH_MFA_CHALLENGE_TTL_SECONDS=300

# ------------------------------------------------------------
# SERVICE CAPACITY
# ------------------------------------------------------------
CORE_WEB_CONCURRENCY=2
AUTH_WEB_CONCURRENCY=2

# ------------------------------------------------------------
# EMAIL AND CONTACT
# ------------------------------------------------------------
# Secret file required in SECRETS_DIR:
#   resend_api_key
NOTIFICATION_DEFAULT_FROM_EMAIL=no-reply@rubricasignature.com
RESEND_FROM_EMAIL=Rubrica <no-reply@rubricasignature.com>
CONTACT_INBOX_EMAIL=contact@rubricasignature.com

# ------------------------------------------------------------
# DOCUMENT UPLOAD LIMITS
# ------------------------------------------------------------
# 50 MiB in bytes.
DOCUMENT_MAX_SIZE_BYTES=52428800
DOCUMENT_MAX_PAGES=1000

# ------------------------------------------------------------
# CLOUDFLARE TURNSTILE
# ------------------------------------------------------------
# Site key from a Turnstile widget for rubricasignature.com. Store the secret
# only in SECRETS_DIR/contact_turnstile_secret_key.
CONTACT_TURNSTILE_SITE_KEY=
