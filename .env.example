# ------------------------------------
# GLOBAL
# ------------------------------------
APP_NAME=Rubrica
ENVIRONMENT=development
APP_DEBUG=true

# ------------------------------------
# API PORTS
# ------------------------------------
CORE_API_PORT=8100
CORE_WEB_CONCURRENCY=2
AUTH_API_PORT=8101
EVENTING_API_PORT=8102
NOTIFICATION_API_PORT=8103
OBSERVABILITY_API_PORT=8104
AUTH_API_URL=http://localhost:8101
DOCUMENT_STORAGE_PATH=.rubrica-storage
SIGNING_APP_URL=http://localhost:8080/signing
PUBLIC_WEB_URL=http://localhost:8080
EVIDENCE_SECRET=change-this-evidence-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BRL=
STRIPE_PRICE_USD=
STRIPE_PRICE_JPY=
BILLING_GRACE_PERIOD_DAYS=3
RUBRICA_WEB_PORT=8080
AUTH_SEED_ADMIN_EMAIL=admin@example.local
# Use a unique local password before running `make seed-auth`.
AUTH_SEED_ADMIN_PASSWORD=change-me-before-seeding
AUTH_WEB_CONCURRENCY=2
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_HOST_PORT=6381

# ------------------------------------
# DATABASE
# ------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_HOST_PORT=5435
POSTGRES_USER=rubrica
POSTGRES_PASSWORD=rubrica
POSTGRES_DB=rubrica
CORE_POSTGRES_DB=rubrica_core
AUTH_POSTGRES_DB=rubrica_auth
EVENTING_POSTGRES_DB=rubrica_eventing
NOTIFICATION_POSTGRES_DB=rubrica_notification
OBSERVABILITY_POSTGRES_DB=rubrica_observability
CORE_REDIS_ENABLED=false

# ------------------------------------
# EVENTING, EMAIL AND OBSERVABILITY
# ------------------------------------
EVENTING_DEFAULT_EVENT_TOPIC=rubrica.events
EVENTING_DEAD_LETTER_TOPIC=rubrica.events.dead_letter
NOTIFICATION_PERSISTENCE_MODE=durable
NOTIFICATION_EMAIL_PROVIDER=local_ack
NOTIFICATION_DEFAULT_FROM_EMAIL=no-reply@rubrica.local
SENDGRID_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Rubrica <onboarding@resend.dev>
NOTIFICATION_INTERNAL_SERVICE_KEY=change-this-shared-service-key
AUTH_PUBLIC_WEB_URL=http://localhost:8080
AUTH_MFA_ISSUER=Rubrica
AUTH_MFA_ENCRYPTION_KEY=rubrica-development-mfa-key-change-me
AUTH_IDENTITY_ENCRYPTION_KEY=rubrica-development-identity-key-change-me
AUTH_IDENTITY_HMAC_KEY=rubrica-development-identity-hmac-change-me
AUTH_JP_MY_NUMBER_ENABLED=false
AUTH_MFA_CHALLENGE_TTL_SECONDS=300
OBSERVABILITY_PERSISTENCE_MODE=incidents
SENTRY_DSN=
