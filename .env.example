# ============================================================
# RUBRICA - LOCAL ENVIRONMENT
# ============================================================
# Copy this file to .env and edit it with:
#   nano .env
#
# Values in this template are for local development only.

# ------------------------------------------------------------
# RUNTIME AND SECRET FILES
# ------------------------------------------------------------
ENVIRONMENT=development
SECRETS_DIR=/etc/rubrica/secrets

# ------------------------------------------------------------
# SHARED INFRASTRUCTURE
# ------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=rubrica
POSTGRES_PASSWORD=rubrica
POSTGRES_DB=rubrica

# ------------------------------------------------------------
# WEB AND GATEWAY
# ------------------------------------------------------------
GATEWAY_HOST_PORT=7171
WEB_HOST_PORT=7180
AUTH_API_HOST_PORT=7101
CORE_API_HOST_PORT=7102
EVENTING_API_HOST_PORT=7103
NOTIFICATION_API_HOST_PORT=7104
REDIS_HOST_PORT=7379
POSTGRES_HOST_PORT=7432
PUBLIC_WEB_URL=http://localhost:7171
SIGNING_APP_URL=http://localhost:7171/signing

# ------------------------------------------------------------
# CORE API
# ------------------------------------------------------------
CORE_WEB_CONCURRENCY=2
CORE_POSTGRES_DB=rubrica_core
EVIDENCE_SECRET=change-this-local-evidence-secret
DOCUMENT_MAX_SIZE_BYTES=52428800
DOCUMENT_MAX_PAGES=1000
DOCUMENT_STORAGE_PROVIDER=local
TENANT_IDENTITY_ENCRYPTION_KEY=rubrica-development-tenant-encryption-key-change-me
TENANT_IDENTITY_HMAC_KEY=rubrica-development-tenant-hmac-key-change-me
R2_DOCUMENTS_PREFIX=documents
# Set to r2 after creating the private rubrica-documents bucket and the four
# r2_documents_* files in SECRETS_DIR.

# --- Billing: fake by default; Stripe secrets live in SECRETS_DIR when enabled ---
BILLING_PROVIDER=fake

# --- Essential: 20 documents per month ---
STRIPE_PRICE_ESSENTIAL_MONTHLY_BRL=
STRIPE_PRICE_ESSENTIAL_MONTHLY_USD=
STRIPE_PRICE_ESSENTIAL_MONTHLY_EUR=
STRIPE_PRICE_ESSENTIAL_MONTHLY_JPY=
STRIPE_PRICE_ESSENTIAL_ANNUAL_BRL=
STRIPE_PRICE_ESSENTIAL_ANNUAL_USD=
STRIPE_PRICE_ESSENTIAL_ANNUAL_EUR=
STRIPE_PRICE_ESSENTIAL_ANNUAL_JPY=

# --- Professional: 80 documents per month; up to 3 tenant accounts ---
STRIPE_PRICE_PROFESSIONAL_MONTHLY_BRL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY_USD=
STRIPE_PRICE_PROFESSIONAL_MONTHLY_EUR=
STRIPE_PRICE_PROFESSIONAL_MONTHLY_JPY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL_BRL=
STRIPE_PRICE_PROFESSIONAL_ANNUAL_USD=
STRIPE_PRICE_PROFESSIONAL_ANNUAL_EUR=
STRIPE_PRICE_PROFESSIONAL_ANNUAL_JPY=

# --- Team: 200 documents per month; up to 10 tenant accounts ---
STRIPE_PRICE_TEAM_MONTHLY_BRL=
STRIPE_PRICE_TEAM_MONTHLY_USD=
STRIPE_PRICE_TEAM_MONTHLY_EUR=
STRIPE_PRICE_TEAM_MONTHLY_JPY=
STRIPE_PRICE_TEAM_ANNUAL_BRL=
STRIPE_PRICE_TEAM_ANNUAL_USD=
STRIPE_PRICE_TEAM_ANNUAL_EUR=
STRIPE_PRICE_TEAM_ANNUAL_JPY=
STRIPE_PORTAL_CONFIGURATION_ID=

# --- Grace Period ---
BILLING_GRACE_PERIOD_DAYS=10

# ------------------------------------------------------------
# AUTH API
# ------------------------------------------------------------
AUTH_WEB_CONCURRENCY=2
AUTH_POSTGRES_DB=rubrica_auth
AUTH_PUBLIC_WEB_URL=http://localhost:7171
AUTH_SEED_ADMIN_EMAIL=admin@example.local
SERPROID_CLIENT_ID=
SERPROID_CLIENT_SECRET=
SERPROID_ENVIRONMENT=homologation
SERPRO_TIMESTAMP_CONSUMER_KEY=
SERPRO_TIMESTAMP_CONSUMER_SECRET=
SERPRO_TIMESTAMP_PROVIDER=fake
# Set a unique local password before running make seed-auth.
AUTH_SEED_ADMIN_PASSWORD=change-me-before-seeding
LOCAL_TEST_ACCOUNT_PASSWORD=RubricaLocal123!

# --- MFA and identity ---
AUTH_MFA_ISSUER=Rubrica
AUTH_MFA_ENCRYPTION_KEY=rubrica-development-mfa-key-change-me
AUTH_MFA_CHALLENGE_TTL_SECONDS=300
AUTH_IDENTITY_ENCRYPTION_KEY=rubrica-development-identity-key-change-me
AUTH_IDENTITY_HMAC_KEY=rubrica-development-identity-hmac-change-me
AUTH_JP_MY_NUMBER_ENABLED=false

# ------------------------------------------------------------
# INTERNAL API AUTHENTICATION
# ------------------------------------------------------------
# Sent through X-Rubrica-Service and X-Rubrica-Service-Key.
CORE_INTERNAL_SERVICE_KEY=change-this-local-core-service-key
NOTIFICATION_INTERNAL_SERVICE_KEY=change-this-local-notification-key
NOTIFICATION_INTERNAL_ALLOWED_SERVICES_RAW=auth_api,core_api,bootstrap

# ------------------------------------------------------------
# NOTIFICATION API
# ------------------------------------------------------------
NOTIFICATION_POSTGRES_DB=rubrica_notification
NOTIFICATION_PERSISTENCE_MODE=durable
NOTIFICATION_EMAIL_PROVIDER=local_ack
NOTIFICATION_DEFAULT_FROM_EMAIL=no-reply@rubrica.local
CONTACT_INBOX_EMAIL=contact@rubricasignature.com
CONTACT_TURNSTILE_SITE_KEY=
CONTACT_TURNSTILE_SECRET_KEY=

# --- Resend: API key lives in SECRETS_DIR ---
RESEND_FROM_EMAIL=Rubrica <onboarding@resend.dev>

# --- Optional SendGrid fallback ---
SENDGRID_API_KEY=

# ------------------------------------------------------------
# EVENTING API
# ------------------------------------------------------------
EVENTING_POSTGRES_DB=rubrica_eventing
EVENTING_DEFAULT_EVENT_TOPIC=rubrica.events
EVENTING_DEAD_LETTER_TOPIC=rubrica.events.dead_letter
